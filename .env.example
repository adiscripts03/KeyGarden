# KeyGarden Environment Variables
# Ethereum RPC URL (Optional for live Sepolia testnet execution; built-in simulated sandbox works out-of-the-box)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# ERC-4337 Bundler & Paymaster (Optional - Pimlico / Biconomy / Alchemy)
NEXT_PUBLIC_BUNDLER_URL=
NEXT_PUBLIC_PAYMASTER_URL=

# Deployed Smart Contract Addresses on Testnet
NEXT_PUBLIC_KEYGARDEN_REGISTRY_ADDRESS=0x1234567890123456789012345678901234567890
NEXT_PUBLIC_MOCK_TREASURY_ADDRESS=0x9876543210987654321098765432109876543210
NEXT_PUBLIC_MOCK_VENDOR_ADDRESS=0xabcdef0123456789abcdef0123456789abcdef01
